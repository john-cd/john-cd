// Format maintained documentation and configuration files.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "newLineKind": "lf",
  "markdown": {
    "lineWidth": 100,
    "textWrap": "maintain"
  },
  "includes": ["**/*.md", "**/*.json", "**/*.jsonc", "**/*.yaml", "**/*.yml"],
  "excludes": ["**/.git/**", "**/.worktrees/**"],
  "plugins": [
    "npm:@dprint/markdown@0.28.0",
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
